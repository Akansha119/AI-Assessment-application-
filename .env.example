# AssessIQ environment variables (example - copy to .env and fill in real values)
# NEVER commit real .env files or secrets to source control

# ===== Application =====
APP_NAME=assessiq
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production-32-random-chars
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ===== Database (PostgreSQL) =====
DATABASE_URL=postgresql+psycopg://assessiq:assessiq@localhost:5432/assessiq
POSTGRES_USER=assessiq
POSTGRES_PASSWORD=assessiq
POSTGRES_DB=assessiq
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ===== Security =====
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# ===== Redis / Celery =====
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ===== AI Provider (provider-independent via service layer) =====
# Set exactly one provider implementation via env; do not hardcode a provider.
AI_PROVIDER=mock                    # mock | openai | anthropic | azure | bedrock
AI_PROVIDER_API_KEY=                # required for real providers
AI_PROVIDER_BASE_URL=               # optional, provider-specific
AI_MODEL_DEFAULT=gpt-4o-mini
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2000
AI_RATE_LIMIT_PER_MIN=20

# ===== pgvector / embeddings =====
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ===== File Upload =====
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_TYPES=application/pdf,application/msapplication,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ===== CORS =====
CORS_ORIGINS=http://localhost:3000

# ===== Logging =====
LOG_LEVEL=INFO
LOG_FORMAT=json
